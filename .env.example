# Runtime 脱敏变量，仅为配置文件中的 ${VAR} 占位符提供值
QQ_BOT_APP_ID=
QQ_BOT_APP_SECRET=
QWEN_API_KEY=
QWEN_BASE_URL=
PUBLIC_BASE_URL=http://127.0.0.1:3000
NAPCAT_TOKEN=
SYNAPSE_ADMIN_TOKEN=
BRAVE_SEARCH_API_KEY=

# 群聊工件部署 examples/group-artifacts.config.toml
# 填写模型凭据、NapCat WebSocket 地址与机器人 QQ 号后再启动此示例
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_API_KEY=
MODEL_NAME=qwen-plus
NAPCAT_WS_URL=ws://127.0.0.1:3001
QQ_BOT_ID=


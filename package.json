{
  "name": "synapse-runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "verify": "pnpm env:check && pnpm fmt:check && pnpm lint && pnpm architecture:check && pnpm fixtures:validate && pnpm build && pnpm typecheck && pnpm config:check && pnpm i18n:check && pnpm test",
    "env:check": "node tools/check-environment.mjs",
    "native:rebuild": "pnpm --filter @synapse/runtime-core exec npm rebuild better-sqlite3",
    "container:smoke": "node tools/container-smoke.mjs",
    "build": "pnpm -r build",
    "docs:build": "pnpm --filter @synapse/docs build",
    "docs:dev": "pnpm --filter @synapse/docs dev",
    "docs:preview": "pnpm --filter @synapse/docs preview",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "fixtures:validate": "node tools/channel-fixtures/validate-fixtures.mjs",
    "start": "node apps/runtime/dist/cli.js --config runtime.config.toml --env-file .env",
    "tui": "node apps/tui/dist/cli.js",
    "tui:spawn": "node apps/tui/dist/cli.js --spawn --runtime-entry apps/runtime/dist/cli.js --config runtime.config.toml --env-file .env",
    "test": "pnpm -r test && pnpm test:integration",
    "test:integration": "node --test tools/runtime-tui.test.mjs",
    "test:docker": "node tools/docker-execution-smoke.mjs",
    "typecheck": "pnpm -r typecheck",
    "prepare": "husky install",
    "lint-staged": "lint-staged",
    "config:check": "node apps/runtime/dist/check.js config examples/minimal.config.toml",
    "i18n:check": "node apps/runtime/dist/check.js i18n",
    "architecture:check": "node tools/check-boundaries.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^5.9.3",
    "vitest": "^2.0.5"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,jsx}": [
      "oxfmt --write",
      "oxlint --fix"
    ],
    "*.{json,md,css,scss,html}": [
      "oxfmt --write"
    ]
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@9.15.0"
}

{
  "name": "synapse-runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "fixtures:validate": "node tools/channel-fixtures/validate-fixtures.mjs",
    "start": "node apps/runtime/dist/cli.js --config examples/runtime.config.toml --env-file .env",
    "tui": "node apps/runtime/dist/cli.js console",
    "tui:spawn": "node apps/runtime/dist/cli.js console --config examples/runtime.config.toml --env-file .env --spawn",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "prepare": "husky install",
    "lint-staged": "lint-staged",
    "config:check": "node apps/runtime/dist/check.js config examples/minimal.config.toml",
    "i18n:check": "node apps/runtime/dist/check.js i18n",
    "architecture:check": "node tools/check-boundaries.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "husky": "^8.0.0",
    "lint-staged": "^14.0.0",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "typescript": "^5.5.4",
    "vitepress": "^1.6.4",
    "vitest": "^2.0.5"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,jsx}": [
      "oxfmt --write",
      "oxlint --fix"
    ],
    "*.{json,md,css,scss,html}": [
      "oxfmt --write"
    ]
  },
  "packageManager": "pnpm@9.15.0"
}

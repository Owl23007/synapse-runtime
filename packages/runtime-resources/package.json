{
  "name": "@synapse/runtime-resources",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./i18n": {
      "types": "./dist/i18n.d.ts",
      "import": "./dist/i18n.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@synapse/runtime-config": "workspace:*",
    "@synapse/runtime-conversation": "workspace:*",
    "@synapse/runtime-i18n": "workspace:*",
    "yaml": "^2.5.0",
    "zod": "^3.23.8",
    "zod-config": "npm:zod@^4.5.4"
  }
}

{
  "name": "@synapse/runtime-tui",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "synapse-tui": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@synapse/runtime-client": "workspace:*",
    "@synapse/runtime-config": "workspace:*",
    "@synapse/runtime-user-config": "workspace:*",
    "ink": "^5.2.1",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18"
  }
}

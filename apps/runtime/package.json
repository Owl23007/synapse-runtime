{
  "name": "@synapse/runtime-server",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "synapse-maintenance": "./dist/maintenance.js",
    "synapse-runtime": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./i18n": {
      "types": "./dist/i18n.d.ts",
      "import": "./dist/i18n.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@synapse/runtime-agent-api-provider": "workspace:*",
    "@synapse/runtime-agent-core": "workspace:*",
    "@synapse/runtime-agent-loop": "workspace:*",
    "@synapse/runtime-channel": "workspace:*",
    "@synapse/runtime-channel-onebot11": "workspace:*",
    "@synapse/runtime-channel-qq-official": "workspace:*",
    "@synapse/runtime-client": "workspace:*",
    "@synapse/runtime-config": "workspace:*",
    "@synapse/runtime-conversation": "workspace:*",
    "@synapse/runtime-core": "workspace:*",
    "@synapse/runtime-i18n": "workspace:*",
    "@synapse/runtime-permission": "workspace:*",
    "@synapse/runtime-protocol": "workspace:*",
    "@synapse/runtime-resources": "workspace:*",
    "@synapse/runtime-tool-container": "workspace:*",
    "@synapse/runtime-tool-execution": "workspace:*",
    "@synapse/runtime-tool-mcp": "workspace:*",
    "@synapse/runtime-tool-runtime": "workspace:*",
    "@synapse/runtime-tool-web": "workspace:*",
    "@synapse/runtime-user-config": "workspace:*",
    "nova-http": "^0.2.1",
    "pdfjs-dist": "^6.4.299",
    "zod": "^4.6.7"
  }
}
